gui/node_modules/
gui/dist/

# The built workbench interface is committed on purpose. It ships inside the
# wheel, and an installed copy must serve an interface without a Node toolchain.
!src/smartmoney_cub_harness/workbench/web/
!src/smartmoney_cub_harness/workbench/web/**

# Local reference projects. Archived in the workspace for reference, never part of
# the harness source, the wheel, or the published repository.
reference/

# Third-party build output kept locally for contract verification only. The
# bundle is copyrighted material, is never republished, and must not be
# committed; scripts/trader-oracle.sh documents how it is used.
scripts/tradezella.bundle.js
work/

# Visual check output: regenerated by scripts/visual-check.sh, and the temporary
# store inside it is a throwaway database.
artifacts/visual/*.png
artifacts/visual/tmp-state/
