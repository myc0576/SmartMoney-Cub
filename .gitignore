# OpenDesign editor-side render scratch (kept ignored)
tmp-render/

# GUI node_modules & dist
gui/node_modules/
gui/dist/

# Root-level node_modules: the visual and acceptance scripts resolve playwright,
# pngjs, and looks-same from the repository root, so a `npm install` here is how
# a contributor gets the harness runnable. The install is reproducible from the
# committed package.json and package-lock.json; the tree itself is not source.
node_modules/

# Local reverse-engineering scratch that a prior session left in the tree. It
# carries absolute paths into one machine's work directories, so publishing it
# would leak a local layout. ledger.md is a private, session-specific notes file
# and never part of the product.
.frx-context/
.frx-notes.ndjson
ledger.md

# The built workbench interface is committed on purpose. It ships inside the
# wheel, and an installed copy must serve an interface without a Node toolchain.
!src/smartmoney_cub_harness/workbench/web/
!src/smartmoney_cub_harness/workbench/web/**

# Local reference projects. Archived in the workspace for reference, never part of
# the harness source, the wheel, or the published repository.
reference/

# Third-party build output kept locally for contract verification only. The
# bundle is copyrighted material, is never republished, and must not be
# committed; scripts/trader-oracle.sh documents how it is used.
scripts/tradezella.bundle.js
work/

# Visual check output: regenerated by scripts/visual-check.sh, and the temporary
# store inside it is a throwaway database.
artifacts/visual/*.png
artifacts/visual/tmp-state/

# Local outputs and downloads
graphify-out/
release_downloads/

# Playwright End-to-End Test Artifacts
test-results/
playwright-report/
playwright/.cache/


# Optional local JEV credentials, including atomic-write temporary files.
jev-credentials.json
.jev-*
