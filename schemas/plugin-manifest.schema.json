{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myc0576/smartmoney-cub-harness/schemas/plugin-manifest.schema.json",
  "title": "Smartmoney Cub Plugin Manifest v1",
  "description": "Read-only plugin declaration. A manifest may describe data, review, evaluation, replay, report, memory, model, and agent seams. It may never describe order, cancel, trade, account, or broker execution.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "plugin_id",
    "name",
    "version",
    "source_repo",
    "license",
    "kind",
    "trust_level",
    "api_range",
    "capabilities",
    "data_time_semantics",
    "safety"
  ],
  "properties": {
    "schema": { "const": "smartmoney_cub_plugin_manifest.v1" },
    "plugin_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source_repo": { "type": "string", "minLength": 1 },
    "source_commit": { "type": ["string", "null"] },
    "source_tag": { "type": ["string", "null"] },
    "license": { "type": "string", "minLength": 1 },
    "maintainer": { "type": ["string", "null"] },
    "kind": {
      "enum": ["entry-point", "local-path", "subprocess", "companion"]
    },
    "trust_level": {
      "enum": ["core", "review-only", "data-network", "untrusted-external"]
    },
    "api_range": { "type": "string", "minLength": 1 },
    "entrypoint": {
      "description": "Import spec for entry-point plugins, or a command for subprocess plugins.",
      "type": ["string", "array", "null"],
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "not": {
          "pattern": "(?i)(order|cancel|trade_execution|account_mutation|broker)"
        }
      }
    },
    "provides": { "type": "array", "items": { "type": "string" } },
    "required_services": { "type": "array", "items": { "type": "string" } },
    "optional_services": { "type": "array", "items": { "type": "string" } },
    "input_schema": { "type": ["object", "null"] },
    "output_schema": { "type": ["object", "null"] },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "pattern": "(?i)(order|cancel|trade_execution|account_mutation|broker)"
        }
      }
    },
    "network_required": { "type": "boolean", "default": false },
    "credential_requirements": {
      "description": "Credential names only. Values stay in the user environment and must never enter artifacts.",
      "type": "array",
      "items": { "type": "string" }
    },
    "supported_markets": { "type": "array", "items": { "type": "string" } },
    "data_time_semantics": {
      "enum": ["point_in_time", "historical_export", "live_fetch", "derived_static"]
    },
    "health_check": { "type": ["string", "null"] },
    "provenance_policy": { "type": "string" },
    "description": { "type": "string" },
    "safety": { "const": "READ_ONLY_NO_ORDER_NO_CANCEL_NO_TRADE" }
  }
}
