{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myc0576/SmartMoney-Cub/schemas/onchain_snapshot.schema.json",
  "title": "Smartmoney Cub Offline Onchain Snapshot v1",
  "description": "Frozen toy or private Arbitrum One single-transaction evidence. Runtime validation additionally enforces associations, time ordering/cutoffs, unique claim/log identities, and receipt consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "chain_id", "decision_time", "evaluation_mode", "transaction", "receipt", "block", "claims", "finality_observation", "safety"],
  "properties": {
    "schema": {"const": "smartmoney_cub_onchain_snapshot.v1"},
    "chain_id": {"type": "integer", "const": 42161},
    "decision_time": {"$ref": "#/$defs/timestamp"},
    "evaluation_mode": {"enum": ["pre_decision", "post_decision"]},
    "transaction": {"$ref": "#/$defs/transactionEnvelope"},
    "receipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/receiptEnvelope"}]},
    "block": {"$ref": "#/$defs/blockEnvelope"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "finality_observation": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/finalityEnvelope"}]},
    "safety": {"const": "READ_ONLY_NO_ORDER_NO_CANCEL_NO_TRADE"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|(?!-00:00$)[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "quantity": {"type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]*)$"},
    "uint256": {"type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,63})$"},
    "bytes": {"type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})*$"},
    "optionalRpcFields": {
      "type": "object",
      "properties": {
        "gas": {"$ref": "#/$defs/quantity"},
        "gasPrice": {"$ref": "#/$defs/quantity"},
        "value": {"$ref": "#/$defs/quantity"},
        "type": {"$ref": "#/$defs/quantity"},
        "maxFeePerGas": {"$ref": "#/$defs/quantity"},
        "maxPriorityFeePerGas": {"$ref": "#/$defs/quantity"},
        "gasUsed": {"$ref": "#/$defs/quantity"},
        "cumulativeGasUsed": {"$ref": "#/$defs/quantity"},
        "effectiveGasPrice": {"$ref": "#/$defs/quantity"},
        "timestamp": {"$ref": "#/$defs/quantity"},
        "baseFeePerGas": {"$ref": "#/$defs/quantity"},
        "gasLimit": {"$ref": "#/$defs/quantity"},
        "size": {"$ref": "#/$defs/quantity"},
        "difficulty": {"$ref": "#/$defs/quantity"},
        "totalDifficulty": {"$ref": "#/$defs/quantity"},
        "blobGasUsed": {"$ref": "#/$defs/quantity"},
        "excessBlobGas": {"$ref": "#/$defs/quantity"},
        "from": {"$ref": "#/$defs/address"},
        "to": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
        "contractAddress": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
        "chainId": {"const": "0xa4b1"}
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at", "available_at", "evidence_role", "data"],
      "properties": {
        "source": {"$ref": "#/$defs/nonempty"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "evidence_role": {"enum": ["pre_decision", "post_decision"]},
        "data": {"type": "object"}
      }
    },
    "transactionEnvelope": {
      "allOf": [{"$ref": "#/$defs/envelope"}, {"properties": {"data": {"$ref": "#/$defs/transaction"}}}]
    },
    "receiptEnvelope": {
      "allOf": [{"$ref": "#/$defs/envelope"}, {"properties": {"data": {"$ref": "#/$defs/receipt"}}}]
    },
    "blockEnvelope": {
      "allOf": [{"$ref": "#/$defs/envelope"}, {"properties": {"data": {"$ref": "#/$defs/block"}}}]
    },
    "finalityEnvelope": {
      "allOf": [{"$ref": "#/$defs/envelope"}, {"properties": {"data": {"$ref": "#/$defs/finality"}}}]
    },
    "transaction": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/optionalRpcFields"}],
      "required": ["hash", "chainId", "from", "to", "blockHash", "blockNumber", "transactionIndex"],
      "properties": {
        "hash": {"$ref": "#/$defs/hash"},
        "chainId": {"const": "0xa4b1"},
        "from": {"$ref": "#/$defs/address"},
        "to": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
        "blockHash": {"$ref": "#/$defs/hash"},
        "blockNumber": {"$ref": "#/$defs/quantity"},
        "transactionIndex": {"$ref": "#/$defs/quantity"},
        "nonce": {"$ref": "#/$defs/quantity"}
      },
      "additionalProperties": true
    },
    "block": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/optionalRpcFields"}],
      "required": ["hash", "number", "transactions"],
      "properties": {
        "hash": {"$ref": "#/$defs/hash"},
        "number": {"$ref": "#/$defs/quantity"},
        "transactions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "nonce": {"type": "string", "pattern": "^0x[0-9a-fA-F]{16}$"}
      },
      "additionalProperties": true
    },
    "receipt": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/optionalRpcFields"}],
      "if": {"properties": {"status": {"const": "0x0"}}, "required": ["status"]},
      "then": {"properties": {"logs": {"maxItems": 0}}},
      "required": ["transactionHash", "transactionIndex", "blockHash", "blockNumber", "status", "logs"],
      "properties": {
        "transactionHash": {"$ref": "#/$defs/hash"},
        "transactionIndex": {"$ref": "#/$defs/quantity"},
        "blockHash": {"$ref": "#/$defs/hash"},
        "blockNumber": {"$ref": "#/$defs/quantity"},
        "status": {"enum": ["0x0", "0x1"]},
        "logs": {"type": "array", "items": {"$ref": "#/$defs/log"}},
        "nonce": {"$ref": "#/$defs/quantity"}
      },
      "additionalProperties": true
    },
    "log": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/optionalRpcFields"}],
      "required": ["address", "topics", "data", "blockHash", "blockNumber", "transactionHash", "transactionIndex", "logIndex", "removed"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "topics": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/hash"}},
        "data": {"$ref": "#/$defs/bytes"},
        "blockHash": {"$ref": "#/$defs/hash"},
        "blockNumber": {"$ref": "#/$defs/quantity"},
        "transactionHash": {"$ref": "#/$defs/hash"},
        "transactionIndex": {"$ref": "#/$defs/quantity"},
        "logIndex": {"$ref": "#/$defs/quantity"},
        "removed": {"const": false},
        "nonce": {"$ref": "#/$defs/quantity"}
      },
      "additionalProperties": true
    },
    "finality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "blockHash", "blockNumber"],
      "properties": {
        "tag": {"enum": ["safe", "finalized"]},
        "blockHash": {"$ref": "#/$defs/hash"},
        "blockNumber": {"$ref": "#/$defs/quantity"}
      }
    },
    "claim": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "value"],
          "properties": {
            "id": {"$ref": "#/$defs/nonempty"},
            "type": {"const": "sender"},
            "value": {"$ref": "#/$defs/address"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "value"],
          "properties": {
            "id": {"$ref": "#/$defs/nonempty"},
            "type": {"const": "recipient"},
            "value": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "value"],
          "properties": {
            "id": {"$ref": "#/$defs/nonempty"},
            "type": {"const": "execution_status"},
            "value": {"enum": ["success", "failure"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "event_type", "contract", "from", "to", "value"],
          "properties": {
            "id": {"$ref": "#/$defs/nonempty"},
            "type": {"const": "event"},
            "event_type": {"const": "erc20_transfer"},
            "contract": {"$ref": "#/$defs/address"},
            "from": {"$ref": "#/$defs/address"},
            "to": {"$ref": "#/$defs/address"},
            "value": {"$ref": "#/$defs/uint256"}
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "event_type"],
          "properties": {
            "id": {"$ref": "#/$defs/nonempty"},
            "type": {"const": "event"},
            "event_type": {"allOf": [{"$ref": "#/$defs/nonempty"}, {"not": {"const": "erc20_transfer"}}]}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": {"$ref": "#/$defs/nonempty"},
            "type": {"allOf": [{"$ref": "#/$defs/nonempty"}, {"not": {"enum": ["sender", "recipient", "execution_status", "event"]}}]}
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
